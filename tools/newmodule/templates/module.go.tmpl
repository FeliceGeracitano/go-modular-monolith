// Package {{.Name}} is the {{.Name}} module.
//
// This package is the module's composition point. Only the composition root
// (internal/bootstrap) may import it. Other modules depend on the contract
// in {{.Name}}api; everything under internal/ is private to the module and
// the Go compiler enforces it.
package {{.Name}}

import (
	"embed"
	"io/fs"
	"net/http"

	"{{.ModulePath}}/internal/modules/{{.Name}}/internal/adapters/httpapi"
	"{{.ModulePath}}/internal/modules/{{.Name}}/internal/adapters/pgstore"
	"{{.ModulePath}}/internal/modules/{{.Name}}/internal/app"
	"{{.ModulePath}}/internal/platform/eventbus"
	"{{.ModulePath}}/internal/platform/module"
	"{{.ModulePath}}/internal/platform/postgres"
)

//go:embed migrations/*.sql
var migrations embed.FS

// Deps are the module's dependencies, supplied by the composition root.
// Add what the module needs here (a clock, an event publisher, another
// module's API) and pass it in from internal/bootstrap/modules.go.
type Deps struct {
	// DB is restricted to this module's own schema.
	DB *postgres.DB
}

// Module is the {{.Name}} module.
type Module struct {
	handler *httpapi.Handler
}

var _ module.Module = (*Module)(nil)

// New assembles the module.
func New(deps Deps) *Module {
	svc := app.NewService(pgstore.NewStore(deps.DB))
	return &Module{handler: httpapi.NewHandler(svc)}
}

// Name implements module.Module.
func (m *Module) Name() string { return "{{.Name}}" }

// Migrations implements module.Module.
func (m *Module) Migrations() fs.FS {
	sub, err := fs.Sub(migrations, "migrations")
	if err != nil {
		panic(err) // unreachable: the directory is embedded at build time
	}
	return sub
}

// RegisterRoutes implements module.Module.
func (m *Module) RegisterRoutes(mux *http.ServeMux) { m.handler.Register(mux) }

// RegisterSubscribers implements module.Module. Subscribe to other modules'
// integration events here.
func (m *Module) RegisterSubscribers(eventbus.Subscriber) {}
