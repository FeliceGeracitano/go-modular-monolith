// Package pgstore is the PostgreSQL adapter for the {{.Name}} module. It
// only ever touches tables in the "{{.Name}}" schema; the database role it
// runs as cannot reach any other.
package pgstore

import (
	"context"
	"fmt"

	"{{.ModulePath}}/internal/platform/postgres"
)

// Store implements app.Store.
type Store struct {
	db *postgres.DB
}

// NewStore returns a Store backed by db.
func NewStore(db *postgres.DB) *Store {
	return &Store{db: db}
}

// Ping implements app.Store.
func (s *Store) Ping(ctx context.Context) error {
	// db.Conn(ctx) returns the transaction carried by ctx when the use case
	// opened one, and the pool otherwise.
	if _, err := s.db.Conn(ctx).Exec(ctx, `SELECT 1`); err != nil {
		return fmt.Errorf("{{.Name}}: ping: %w", err)
	}
	return nil
}
