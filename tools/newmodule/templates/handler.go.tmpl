// Package httpapi is the HTTP adapter for the {{.Name}} module. It
// translates HTTP to use-case calls and back; it holds no business logic.
package httpapi

import (
	"net/http"

	"{{.ModulePath}}/internal/modules/{{.Name}}/internal/app"
	"{{.ModulePath}}/internal/platform/httpx"
)

// Handler serves the {{.Name}} endpoints.
type Handler struct {
	svc *app.Service
}

// NewHandler returns a Handler.
func NewHandler(svc *app.Service) *Handler {
	return &Handler{svc: svc}
}

// Register mounts the module's routes.
func (h *Handler) Register(mux *http.ServeMux) {
	mux.HandleFunc("GET /api/v1/{{.Name}}/status", h.status)
}

// Response types are the HTTP contract and are kept separate from the
// module's internal types.
type statusResponse struct {
	Module string `json:"module"`
	Status string `json:"status"`
}

func (h *Handler) status(w http.ResponseWriter, r *http.Request) {
	status, err := h.svc.Status(r.Context())
	if err != nil {
		httpx.Error(w, r, err)
		return
	}
	httpx.JSON(w, http.StatusOK, statusResponse{Module: status.Module, Status: "ok"})
}
