package app_test

import (
	"context"
	"errors"
	"testing"

	"{{.ModulePath}}/internal/modules/{{.Name}}/internal/app"
)

// Use cases are tested against hand-written fakes of their ports.
type fakeStore struct{ err error }

func (f fakeStore) Ping(context.Context) error { return f.err }

func TestStatus(t *testing.T) {
	status, err := app.NewService(fakeStore{}).Status(context.Background())
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if status.Module != "{{.Name}}" {
		t.Fatalf("Module = %q, want {{.Name}}", status.Module)
	}
}

func TestStatusReportsStorageFailure(t *testing.T) {
	down := errors.New("connection refused")

	if _, err := app.NewService(fakeStore{err: down}).Status(context.Background()); !errors.Is(err, down) {
		t.Fatalf("error = %v, want it to wrap the storage failure", err)
	}
}
