# Every setting the server reads, with its default. Only DATABASE_URL is
# required. The server reads real environment variables; it does not load
# this file itself (use your shell, direnv, or docker compose).

DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DATABASE_MAX_CONNS=10

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s

LOG_LEVEL=info
LOG_FORMAT=json

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# Tests only: a server on which integration tests may create databases.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
