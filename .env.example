# Local development settings. Copy to .env; `make` loads it automatically.
#
# This file lists every setting the service reads, with its default. Only
# DATABASE_URL is required. Deployed environments do not use a .env file:
# they set real environment variables (see deploy/env/).

# --- Environment ------------------------------------------------------------
# local | dev | staging | production. Labels logs and telemetry and picks a
# few defaults (for example text logs locally, JSON everywhere else).
APP_ENV=local
# Defaults to the last element of the Go module path.
# SERVICE_NAME=my-service

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Per connection pool. Each module has its own pool, so the service can open
# up to (modules + 2) x this many connections.
DATABASE_MAX_CONNS=10

# --- HTTP -------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
# LOG_FORMAT=text

# --- Events -----------------------------------------------------------------
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# --- Telemetry --------------------------------------------------------------
# Traces and metrics are exported only when an OTLP endpoint is set. Every
# standard OTEL_* variable is honoured. With `make up-observability`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Tests ------------------------------------------------------------------
# A server on which integration tests may create throwaway databases.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
