# Local development settings. Copy to .env; `make` loads it automatically.
#
# This file lists every setting the service reads, with its default. Nothing is
# required to run locally. Deployed environments do not use a .env file: they
# set real environment variables (see deploy/env/).

# --- Environment ------------------------------------------------------------
# local | dev | staging | production. Labels logs and telemetry and picks a
# few defaults (for example text logs locally, JSON everywhere else).
APP_ENV=local
# Defaults to the last element of the Go module path.
# SERVICE_NAME=my-service

# --- HTTP -------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
# LOG_FORMAT=text

# --- Telemetry --------------------------------------------------------------
# Traces and metrics are exported only when an OTLP endpoint is set. Every
# standard OTEL_* variable is honoured. With `make up-observability`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
